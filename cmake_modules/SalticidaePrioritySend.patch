+    SALTICIDAE_LOG_DEBUG("wrote urgent message %s to %s",
+                std::string(msg).c_str(),
+                std::string(*conn).c_str());
+#ifdef SALTICIDAE_MSG_STAT
+    conn->nsent++;
+    conn->nsentb += msg.get_length();
+#endif
+    return conn->write_urgent(std::move(msg_data));
+}
