+template<typename OpcodeType>
+inline bool MsgNetwork<OpcodeType>::_send_msg_priority(
+        const Msg &msg, const conn_t &conn) {
+    bytearray_t msg_data = msg.serialize();
+    SALTICIDAE_LOG_DEBUG("wrote priority message %s to %s",
+                std::string(msg).c_str(),
+                std::string(*conn).c_str());
+#ifdef SALTICIDAE_MSG_STAT
+    conn->nsent++;
+    conn->nsentb += msg.get_length();
+#endif
+    return conn->write_priority(std::move(msg_data));
+}
